{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BlogOS: установка зависимостей",
      "type": "shell",
      "command": "npm install",
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "BlogOS: dev-сервер",
      "type": "shell",
      "command": "npm run dev -- --port 5173 --strictPort",
      "dependsOn": ["BlogOS: установка зависимостей"],
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*"
        }
      }
    }
  ]
}
