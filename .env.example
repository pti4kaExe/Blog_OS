# ─── База данных ──────────────────────────────────────────────────────────────
# По умолчанию — PGlite: настоящий PostgreSQL 16 + pgvector в WASM, запуск без
# Docker и без сети, данные лежат в папке .pglite-data.
# pglite://memory — база в памяти (используется тестами).
DATABASE_URL="pglite://.pglite-data"

# Варианты для настоящего сервера:
#   docker compose up -d db
#   DATABASE_URL="postgresql://blogos:blogos@localhost:5432/blogos"
#   Бесплатный хостинг — Neon (neon.tech), в строке подключения обязателен sslmode:
#   DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/blogos?sslmode=require"

# ─── Сессии и вход ────────────────────────────────────────────────────────────
# Секрет подписи сессионных токенов. На проде — случайная строка ≥ 32 символов.
JWT_SECRET="dev-secret-change-me-in-production-0123456789abcdef"
# 1 — включает dev-вход (telegram_id + имя) для локальной проверки и демо.
# На проде обязательно 0: вход только через Telegram-бота или initData.
DEV_AUTH=1
# ─── Вход через Telegram-бота ─────────────────────────────────────────────────
# Токен бота из @BotFather: нужен и для проверки initData, и для входа по коду.
TELEGRAM_BOT_TOKEN=""
# Username бота без @ (например blogos_login_bot) — из него собирается ссылка t.me/…?start=login_…
TELEGRAM_BOT_USERNAME=""
# Секрет webhook: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token.
# Случайная строка; без неё webhook отвечает 503 и вход через бота не работает.
TELEGRAM_WEBHOOK_SECRET=""
# Публичный адрес API — на него регистрируется webhook: <PUBLIC_API_URL>/telegram/webhook.
PUBLIC_API_URL=""
# Публичный адрес клиента — бот присылает его человеку после входа.
PUBLIC_WEB_URL=""
# Сколько живёт одноразовый код входа (минуты).
LOGIN_CODE_TTL_MINUTES=5
# Лимит расходов на AI по умолчанию для нового канала (рубли).
DEFAULT_MONTHLY_COST_LIMIT=100
# Сколько AI-вызовов в минуту принимаем с одного канала.
AI_CALLS_PER_MINUTE=10
# 1 — проверять сертификат PostgreSQL (включайте, проверив цепочку на своём окружении).
DB_SSL_VERIFY=0
# Применять миграции при старте: нужно на бесплатном Render, где нет preDeployCommand.
RUN_MIGRATIONS_ON_START=0

# ─── Нейросеть (LLM) ──────────────────────────────────────────────────────────
# mock — без сети и денег: детерминированные ответы, тесты и демо работают всегда.
# deepseek — DeepSeek API (https://api.deepseek.com), дешёвые вызовы.
# openai — совместимый по формату API OpenAI.
LLM_PROVIDER="mock"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS=90000
# Бесплатные модели OpenRouter отвечают 7—15 секунд, под нагрузкой дольше.
# Таймаут ниже 60 с даёт откат на правила там, где модель успела бы ответить.
# Минимальный лимит токенов ответа: рассуждающие модели часть бюджета тратят
# на reasoning, и при малом значении ответ приходит пустым. 8192 — с запасом для рассуждающих моделей: лишний лимит не увеличивает расход, но спасает от пустого ответа.
LLM_MAX_TOKENS_FLOOR=8192
# 1 — mock-провайдер всегда отвечает ошибкой: проверка отката на правила
# (в ответе verified_without_ai: true). Для обычной работы — 0.
LLM_MOCK_FAIL=0

# ─── Эмбеддинги и RAG ─────────────────────────────────────────────────────────
# Модель задаёт размерность вектора N. Меняется только вместе с миграцией
# колонки embeddings.vector: vector(1536) ↔ text-embedding-3-small.
EMBEDDINGS_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
RAG_TOP_K=5

# ─── Расходы на AI ────────────────────────────────────────────────────────────
# 0.8 — на 80% месячного лимита канала автор видит предупреждение,
# 1.0 — при достижении лимита AI-вызовы блокируются, проверка идёт на правилах.
COST_WARN_RATIO=0.8

# ─── Сервер ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
LOG_LEVEL="info"
# Redis необязателен: без него очередей нет, всё работает синхронно.
REDIS_URL=""
