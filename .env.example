# ─── База данных ──────────────────────────────────────────────────────────────
# По умолчанию — PGlite: настоящий PostgreSQL 16 + pgvector в WASM, запуск без
# Docker и без сети, данные лежат в папке .pglite-data.
# pglite://memory — база в памяти (используется тестами).
DATABASE_URL="pglite://.pglite-data"

# Варианты для настоящего сервера:
#   docker compose up -d db
#   DATABASE_URL="postgresql://blogos:blogos@localhost:5432/blogos"
#   Бесплатный хостинг — Neon (neon.tech), в строке подключения обязателен sslmode:
#   DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/blogos?sslmode=require"

# ─── Сессии и вход ────────────────────────────────────────────────────────────
# Секрет подписи сессионных токенов. На проде — случайная строка ≥ 32 символов.
JWT_SECRET="dev-secret-change-me-in-production-0123456789abcdef"
# 1 — включает dev-вход POST /auth/dev (только для локальной проверки и демо).
# На проде обязательно 0: метод отсутствует.
DEV_AUTH=1
# Токен бота из @BotFather. Нужен только для проверки подписи Telegram initData.
TELEGRAM_BOT_TOKEN=""

# ─── Нейросеть (LLM) ──────────────────────────────────────────────────────────
# mock — без сети и денег: детерминированные ответы, тесты и демо работают всегда.
# deepseek — DeepSeek API (https://api.deepseek.com), дешёвые вызовы.
# openai — совместимый по формату API OpenAI.
LLM_PROVIDER="mock"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS=45000
# 1 — mock-провайдер всегда отвечает ошибкой: проверка отката на правила
# (в ответе verified_without_ai: true). Для обычной работы — 0.
LLM_MOCK_FAIL=0

# ─── Эмбеддинги и RAG ─────────────────────────────────────────────────────────
# Модель задаёт размерность вектора N. Меняется только вместе с миграцией
# колонки embeddings.vector: vector(1536) ↔ text-embedding-3-small.
EMBEDDINGS_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
RAG_TOP_K=5

# ─── Расходы на AI ────────────────────────────────────────────────────────────
# 0.8 — на 80% месячного лимита канала автор видит предупреждение,
# 1.0 — при достижении лимита AI-вызовы блокируются, проверка идёт на правилах.
COST_WARN_RATIO=0.8

# ─── Сервер ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
LOG_LEVEL="info"
# Redis необязателен: без него очередей нет, всё работает синхронно.
REDIS_URL=""
