{
  "name": "blogos",
  "private": true,
  "version": "2.0.0",
  "description": "BlogOS — целевая версия: React-клиент, серверное API на 59 методов и PostgreSQL + pgvector",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:api": "npm run dev -w @blogos/api",
    "dev:web": "npm run dev -w @blogos/web",
    "build": "npm run build -w @blogos/web && npm run build -w @blogos/api",
    "build:web": "node scripts/build-web.mjs",
    "start": "npm run start -w @blogos/api",
    "test": "npm run test:engine && npm run test:api",
    "test:engine": "npm run test -w @blogos/engine",
    "test:api": "npm run test -w @blogos/api",
    "test:e2e": "node --test --test-isolation=none --test-reporter=spec \"tests/e2e/*.test.mjs\"",
    "test:db": "node tests/db/review.mjs && node scripts/check-schema.mjs",
    "test:contract": "node scripts/check-api.mjs && node tests/db/openapi-structure.mjs",
    "typecheck": "npm run typecheck -w @blogos/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "npm run db:push -w @blogos/api",
    "db:migrate": "npm run db:migrate -w @blogos/api",
    "db:seed": "npm run db:seed -w @blogos/api",
    "db:reset": "npm run db:reset -w @blogos/api",
    "verify": "npm run test && npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
