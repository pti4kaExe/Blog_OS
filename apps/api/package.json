{
  "name": "@blogos/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "BlogOS — серверное API: 59 методов, PostgreSQL + pgvector, правила и LLM",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec test/",
    "db:migrate": "node scripts/migrate.ts",
    "db:push": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "db:reset": "node scripts/reset.ts"
  },
  "dependencies": {
    "@blogos/engine": "*",
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
