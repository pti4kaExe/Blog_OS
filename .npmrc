# Проектные настройки npm.
#
# 1) Кэш лежит внутри рабочей папки: на этой машине профиль пользователя
#    защищён песочницей, и запись в стандартный кэш отклоняется.
# 2) ignore-scripts=true: postinstall-скрипты зависимостей не запускаются.
#    Здесь это безопасно — esbuild ставит бинарник платформенным
#    optionalDependency, а остальные пакеты postinstall не требуют.
#    Если появится пакет, которому нужен postinstall, он ставится отдельной
#    командой с --foreground-scripts.
cache=.npm-cache
ignore-scripts=true
fund=false
audit=false
